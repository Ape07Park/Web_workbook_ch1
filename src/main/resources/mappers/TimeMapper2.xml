<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--namespace를 반드시 매퍼 인터페이스 이름과 동일하게 해야한다-->
<mapper namespace="org.zerock.springex.mapper.TimeMapper2">

<!--    select 태그는 반드시 resultType 혹은 resultMap 속성 지정이 필요하다
        resultType은 sql의 결과를 어떤 타입으로 할 것인지에 대한 것이다. 내가 만든 객체의 경우 경로 지정 필요
        resultMap은 sql의 결과 매핑 방식을 지정하는 속성으로 복잡한 결과 매핑이 필요할 때 사용 (객체 매핑)
-->

<!--    id는 mapper 인터페이스에서 만든 메소드 이름과 동일해야 한다. 그리고 반환 타입 역시 같아야한다.-->
    <select id="getNow" resultType="string">
        select now()
    </select>

</mapper>