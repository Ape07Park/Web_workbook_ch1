<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/mvc https://www.springframework.org/schema/mvc/spring-mvc.xsd http://www.springframework.org/schema/context https://www.springframework.org/schema/context/spring-context.xsd">

<!--    스프링 MVC 관련 설정들-->

<!--    스프링 mvc 설정을 어노테이션 기반으로 처리 및 스프링 mvc의 여러 객체를 자동으로 스프링의 빈으로 등록해줌-->
<!-- conversionService라는 컨버터를 사용할 것임을 알림   -->
    <mvc:annotation-driven conversion-service="conversionService"/>

<!--   이미지나 html 같은 정적 파일의 경로 지정 따라서 /resources 경로로 들어오는 요청은 정적 파일 요청이라 생각해 스프링 mvc에서 처리 안함
    location의 속성 값은 webapp 폴더에 만들어 둔 폴더를 의미한다
-->
    <mvc:resources mapping="/resources/**" location="/resources/"/>

<!--viewResolver는 어떤 뷰를 컨트롤러의 응답(클라이언트에게 반환할 뷰)으로 제공할지 결정한다.
컨트롤러는 return에 있는 값을 view 파일의 이름으로 인식하고 그 파일의 경로를 찾아 실제화면에 렌더링한다.
그중 InternalResourceViewResolver는 디폴트 리졸버로 SP, HTML과 같은 정적인 뷰를 처리할 때 사용한다.
 또한 prefix, suffix를 속성값으로 준다.
 두 속성값은 컨트롤러의 리턴값에서 경로와 확장자를 생략할 수 있게 한다. -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
<!--        WEB-INF 경로와 .jsp라는 확장자를 지정하지 않아도 됨-->
<!--        즉 "/WEB-INF/todo/list.jsp"를 "/todo/list" 로만 표현해도 된다.-->
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

<!--    org.zerock.springex.controller를 스캔해서 빈으로 등록될 수 있게 함-->
    <context:component-scan base-package="org.zerock.springex.controller"/>

<!--    포매터나 컨버터로의 접근을 쉽게 하기 위해 설정 그냥 빈 등록으로 이해해도 됨-->
    <bean id="conversionService" class="org.springframework.format.support.FormattingConversionServiceFactoryBean">

        <property name="formatters">
            <set>
                <bean class="org.zerock.springex.controller.formatter.LocalDateFormatter"/>
            </set>
        </property>
    </bean>

</beans>